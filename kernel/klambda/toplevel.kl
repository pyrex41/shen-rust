" (shen.app (nth (+ 1 V5804) (reverse V5806)) "" shen.a)) (stoutput)) (if (or (= V5805 "") (symbol? V5804)) (shen.recursive-string-match 0 V5805 (reverse V5806)) (simple-error "% expects a number or a symbol
